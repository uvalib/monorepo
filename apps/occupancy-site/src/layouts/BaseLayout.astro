---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'Monthly library occupancy and foot-traffic reports for University of Virginia Library buildings.',
  currentPath = '',
} = Astro.props;

const fullTitle =
  title === 'Home'
    ? 'UVA Library Occupancy Reports'
    : `${title} · UVA Library Occupancy Reports`;

const nav = [
  { href: '/', label: 'Overview', match: '/' },
  { href: '/methodology/', label: 'Methodology', match: '/methodology/' },
  { href: '/libraries/clemons/', label: 'Libraries', match: '/libraries/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" type="image/vnd.microsoft.icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <div class="brand-block">
          <a class="site-logo" href="https://library.virginia.edu/" title="University of Virginia Library">
            <img
              src="/images/library_rgb.png"
              alt="University of Virginia Library"
              width="304"
              height="69"
              decoding="async"
            />
          </a>
          <div class="site-identity">
            <a class="site-identity__title" href="/">Occupancy Reports</a>
            <p class="site-identity__tagline">Monthly foot traffic by library</p>
          </div>
        </div>
      </div>

      <div class="site-nav-bar">
        <div class="site-nav-bar__inner">
          <nav class="nav" aria-label="Primary">
            {
              nav.map((item) => {
                const isCurrent =
                  item.match === '/'
                    ? currentPath === '/'
                    : currentPath.startsWith(item.match);
                return (
                  <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
                    {item.label}
                  </a>
                );
              })
            }
          </nav>
        </div>
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <img
            src="/images/library_rgb.png"
            alt=""
            width="200"
            height="45"
            decoding="async"
            class="site-footer__logo"
          />
          <div>
            <strong>University of Virginia Library</strong>
            <div>Monthly occupancy reporting</div>
          </div>
        </div>
        <div>
          Counts are derived from building entrance cameras and are estimates of visits during open hours.
          See <a href="/methodology/">Methodology</a> for details on the counting system and data quality.
        </div>
        <div>© {new Date().getFullYear()} Rector and Visitors of the University of Virginia</div>
      </div>
    </footer>
  </body>
</html>
