<BaseLayout
  title="Methodology"
  currentPath="/methodology/"
  description="How UVA Library occupancy and foot-traffic counts are produced for monthly reporting."
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Overview</a>
    <span aria-hidden="true">/</span>
    <span>Methodology</span>
